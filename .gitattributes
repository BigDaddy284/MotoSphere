# Normalise all text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows scripts check out with CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: no line-ending conversion, no text diff or merge.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.glb binary
*.ktx2 binary
