# MotoSphere – files that must never be committed.
# Patterns without a leading slash match at any depth.
# Lock files (uv.lock, package-lock.json) are intentionally NOT ignored.

# --- Secrets and local configuration ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# --- Node / frontend ---
node_modules/
*.tsbuildinfo
playwright-report/
test-results/
.vite/

# Published data exported for local use (`npm run data`); never committed.
/frontend/public/data/

# --- Logs and local data ---
*.log
logs/
.cache/

# --- Editors and operating systems ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
Desktop.ini
