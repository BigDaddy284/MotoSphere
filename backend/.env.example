# MotoSphere backend settings, shown with their default values.
# To change a setting, copy this file to .env in the same folder and edit it.
# Never commit .env. Real environment variables take precedence over .env.

# Where MotoSphere is running: development, test or production.
MOTOSPHERE_ENVIRONMENT=development
# How much detail is written to the log: DEBUG, INFO, WARNING, ERROR or CRITICAL.
MOTOSPHERE_LOG_LEVEL=INFO
# Where the data store is kept: the path of an SQLite file. A relative path starts in the backend folder.
MOTOSPHERE_STORE_PATH=store/motosphere.sqlite3
